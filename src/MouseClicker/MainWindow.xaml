<Window x:Class="MouseClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Clicker"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnClosed">
    <Grid Margin="16">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Clicker">
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="TIMING" />
                        <TextBlock Text="Interval (ms, min 10)" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="IntervalSlider"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Minimum="10"
                            Maximum="500"
                            TickFrequency="10"
                            ValueChanged="OnIntervalSliderChanged" />
                    <TextBox x:Name="IntervalBox"
                             Grid.Column="1"
                             Width="72"
                             TextAlignment="Right"
                             TextChanged="OnIntervalChanged" />
                </Grid>

                        <TextBlock x:Name="JitterLabel" Text="Random jitter: 10%" Margin="0,0,0,4" />
                        <Slider x:Name="JitterSlider"
                                Margin="0,0,0,4"
                                Minimum="0"
                                Maximum="50"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnJitterChanged" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="TRIGGER MODE" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="ToggleRadio" Content="Toggle" Margin="0,0,20,0" Checked="OnModeChanged" />
                            <RadioButton x:Name="HoldRadio" Content="Hold" Checked="OnModeChanged" />
                        </StackPanel>

                        <CheckBox x:Name="NotifyCheck" Content="Show notification when clicking starts" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="HOTKEY" />
                        <Button x:Name="HotkeyButton" Style="{StaticResource KeyButton}" Click="OnHotkeyButtonClick" />
                        <TextBlock Style="{StaticResource HintText}" Text="Click to change. Esc cancels." Margin="0,6,0,0" />

                        <Button x:Name="StartStopButton"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0"
                                Height="38"
                                Click="OnStartStopClick" />

                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="CLICKS" />
                        <TextBlock x:Name="ClickCountText"
                                   Text="0"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,18" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="LAST CLICK" />
                        <TextBlock x:Name="LastClickText"
                                   Text="-"
                                   FontFamily="Consolas"
                                   FontSize="18"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Hold">
            <Border Margin="0,16,0,0" Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                <StackPanel>

                    <CheckBox x:Name="HoldEnabledCheck" Content="Enable hold trigger" Checked="OnHoldEnabledChanged" Unchecked="OnHoldEnabledChanged" Margin="0,0,0,4" />
                <CheckBox x:Name="StopOnHeldKeyCheck" Content="Stop hold when I press or release the held key" Checked="OnStopOnHeldKeyChanged" Unchecked="OnStopOnHeldKeyChanged" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource HintText}" Text="Press the trigger key to start holding the key below. Press it again to release." Margin="0,0,0,12" />

                    <Separator Margin="0,4,0,12" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="TRIGGER KEY" />
                    <Button x:Name="HoldTriggerButton" Style="{StaticResource KeyButton}" Click="OnHoldTriggerButtonClick" />
                    <TextBlock Style="{StaticResource HintText}" Text="Click to change. Esc cancels." Margin="0,6,0,0" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="KEY TO HOLD" Margin="0,16,0,6" />
                    <Button x:Name="HeldKeyButton" Style="{StaticResource KeyButton}" Click="OnHeldKeyButtonClick" />
                    <TextBlock Style="{StaticResource HintText}" Text="Click to change. Esc cancels." Margin="0,6,0,0" />

                    <Border Margin="0,18,0,0"
                            Padding="12,10"
                            Background="{StaticResource ControlHoverBrush}"
                            CornerRadius="6">
                        <TextBlock x:Name="HoldStatusText" Text="Not holding" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>

        <!-- Shows which mode is running, sitting on the same row as the tab headers -->
        <Border x:Name="ActivityPill"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Padding="10,5"
                Background="{StaticResource ControlHoverBrush}"
                CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ActivityDot"
                         Width="9"
                         Height="9"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource MutedBrush}" />
                <TextBlock x:Name="ActivityText"
                           Text="Idle"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
