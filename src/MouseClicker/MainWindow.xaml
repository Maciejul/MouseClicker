<Window x:Class="MouseClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Clicker"
        Width="600"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewTextInput="OnPreviewTextInput"
        DataObject.Pasting="OnPaste"
        TextBox.LostFocus="OnNumberBoxLostFocus"
        StateChanged="OnStateChanged"
        Closed="OnClosed">
    <Grid Margin="16">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="Clicker">
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="TIMING" />
                        <TextBlock Text="Interval (ms, min 10)" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="IntervalSlider"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Minimum="10"
                            Maximum="500"
                            TickFrequency="10"
                            ValueChanged="OnIntervalSliderChanged" />
                    <TextBox x:Name="IntervalBox"
                             Grid.Column="1"
                             Width="72"
                             TextAlignment="Right"
                             TextChanged="OnIntervalChanged" />
                </Grid>

                        <TextBlock x:Name="JitterLabel" Text="Random jitter: 10%" Margin="0,0,0,4" />
                        <Slider x:Name="JitterSlider"
                                Margin="0,0,0,4"
                                Minimum="0"
                                Maximum="50"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnJitterChanged" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="TRIGGER MODE" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="ToggleRadio" Content="Toggle" Margin="0,0,20,0" Checked="OnModeChanged" />
                            <RadioButton x:Name="HoldRadio" Content="Hold" Checked="OnModeChanged" />
                        </StackPanel>

                        <CheckBox x:Name="NotifyCheck" Content="Show notification when clicking starts" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Style="{StaticResource SectionLabel}" Text="HOTKEY" />
                        <Button x:Name="HotkeyButton" Style="{StaticResource KeyButton}" Click="OnHotkeyButtonClick" />
                        <TextBlock Style="{StaticResource HintText}" Text="Click to change. Esc cancels." Margin="0,6,0,0" />

                        <Button x:Name="StartStopButton"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0"
                                Height="38"
                                Click="OnStartStopClick" />

                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CLICKS" />
                            <TextBlock x:Name="ClickCountText"
                                       Text="0"
                                       FontSize="40"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Margin="0,0,0,18" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="LAST CLICK" />
                            <TextBlock x:Name="LastClickText"
                                       Text="-"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="CLICK" />
                            <ComboBox x:Name="ClickButtonCombo" Margin="0,0,0,8" SelectionChanged="OnClickOptionsChanged">
                                <ComboBoxItem Content="Left button" />
                                <ComboBoxItem Content="Right button" />
                                <ComboBoxItem Content="Middle button" />
                            </ComboBox>
                            <CheckBox x:Name="DoubleClickCheck" Content="Double click" Checked="OnClickOptionsChanged" Unchecked="OnClickOptionsChanged" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="CLICK AT" Margin="0,14,0,6" />
                            <ComboBox x:Name="ClickTargetCombo" Margin="0,0,0,8" SelectionChanged="OnClickTargetChanged">
                                <ComboBoxItem Content="Cursor position" />
                                <ComboBoxItem Content="Fixed screen point" />
                                <ComboBoxItem Content="Spot in a window" />
                            </ComboBox>
                            <Button x:Name="CaptureButton" Content="Capture (3 s)" Click="OnCaptureClick" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TargetText" Style="{StaticResource HintText}" Margin="0,6,0,0" />

                            <TextBlock Style="{StaticResource SectionLabel}" Text="AUTO-STOP" Margin="0,14,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="After clicks" VerticalAlignment="Center" />
                                <TextBox x:Name="StopClicksBox" Grid.Column="1" Width="64" TextAlignment="Right" TextChanged="OnClickNumberChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="After minutes" VerticalAlignment="Center" />
                                <TextBox x:Name="StopMinutesBox" Grid.Column="1" Width="64" TextAlignment="Right" TextChanged="OnClickNumberChanged" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Text="0 means no limit." Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Hold">
            <Border Margin="0,16,0,0" Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                <StackPanel>

                    <ToggleButton x:Name="HoldEnabledCheck" Style="{StaticResource SwitchButton}" Content="Hold trigger" Checked="OnHoldEnabledChanged" Unchecked="OnHoldEnabledChanged" Margin="0,0,0,12" />
                    <CheckBox x:Name="StopOnHeldKeyCheck" Content="Stop hold when I press or release the held key" Checked="OnStopOnHeldKeyChanged" Unchecked="OnStopOnHeldKeyChanged" Margin="0,0,0,12" />

                    <Separator Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SINGLE TAP" />
                            <RadioButton x:Name="TapToggleRadio" GroupName="Tap" Content="Toggle on / off" Margin="0,0,0,4" Checked="OnHoldOptionsChanged" />
                            <RadioButton x:Name="TapWhileRadio" GroupName="Tap" Content="Hold while the key is pressed" Margin="0,0,0,4" Checked="OnHoldOptionsChanged" />
                            <RadioButton x:Name="TapNoneRadio" GroupName="Tap" Content="Do nothing" Margin="0,0,0,8" Checked="OnHoldOptionsChanged" />
                            <!-- Only shown when a single tap holds while the key is pressed -->
                            <StackPanel x:Name="MaxHoldPanel">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max while pressed (s)" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxHoldBox" Grid.Column="1" Width="56" TextAlignment="Right" TextChanged="OnHoldNumberChanged" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Text="0 means no limit." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="TIMED HOLD" Margin="0,16,0,8" />
                            <CheckBox x:Name="HoldTimedCheck" Checked="OnHoldOptionsChanged" Unchecked="OnHoldOptionsChanged" Margin="0,0,0,8">
                                <TextBlock Text="Multiple taps hold for a set time" TextWrapping="Wrap" />
                            </CheckBox>
                            <!-- Only shown when timed hold is ticked -->
                            <StackPanel x:Name="TimedPanel">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Double tap (s)" VerticalAlignment="Center" />
                                    <TextBox x:Name="DoubleTapBox" Grid.Column="1" Width="56" TextAlignment="Right" TextChanged="OnHoldNumberChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Triple tap (s)" VerticalAlignment="Center" />
                                    <TextBox x:Name="TripleTapBox" Grid.Column="1" Width="56" TextAlignment="Right" TextChanged="OnHoldNumberChanged" />
                                </Grid>
                                <CheckBox x:Name="ExtendCheck" Checked="OnHoldOptionsChanged" Unchecked="OnHoldOptionsChanged" Margin="0,0,0,6">
                                    <TextBlock Text="Tapping during a timed hold adds time" TextWrapping="Wrap" />
                                </CheckBox>
                                <!-- Only shown when adding time is ticked -->
                                <Grid x:Name="ExtendRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time added (s)" VerticalAlignment="Center" />
                                    <TextBox x:Name="ExtendBox" Grid.Column="1" Width="56" TextAlignment="Right" TextChanged="OnHoldNumberChanged" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT TO HOLD" />
                            <ComboBox x:Name="HoldTargetCombo" Margin="0,0,0,6" SelectionChanged="OnHoldOptionsChanged">
                                <ComboBoxItem Content="Keyboard key" />
                                <ComboBoxItem Content="Mouse button" />
                                <ComboBoxItem Content="Key and mouse button" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="TRIGGER KEY" Margin="0,16,0,6" />
                            <Button x:Name="HoldTriggerButton" Style="{StaticResource KeyButton}" Click="OnHoldTriggerButtonClick" />

                            <TextBlock x:Name="HeldKeyLabel" Style="{StaticResource SectionLabel}" Text="KEY TO HOLD" Margin="0,16,0,6" />
                            <Button x:Name="HeldKeyButton" Style="{StaticResource KeyButton}" Click="OnHeldKeyButtonClick" />

                            <TextBlock x:Name="HeldMouseLabel" Style="{StaticResource SectionLabel}" Text="MOUSE KEY TO HOLD" Margin="0,16,0,6" />
                            <ComboBox x:Name="HeldMouseCombo" Width="126" HorizontalAlignment="Left" SelectionChanged="OnHoldOptionsChanged">
                                <ComboBoxItem Content="Left button" />
                                <ComboBoxItem Content="Right button" />
                                <ComboBoxItem Content="Middle button" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintText}" Text="Click a key button to change it. Esc cancels." Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="12,10"
                            Background="{DynamicResource ControlHoverBrush}"
                            CornerRadius="6">
                        <TextBlock x:Name="HoldStatusText" Text="Not holding" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="Settings">
            <Border Margin="0,16,0,0" Style="{StaticResource Card}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="PROFILES" />
                    <ComboBox x:Name="ProfileCombo" Margin="0,0,0,8" SelectionChanged="OnProfileSelected" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameBox" Grid.Column="0" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Save" Margin="0,0,8,0" Click="OnProfileSave" />
                        <Button Grid.Column="2" Content="Delete" Click="OnProfileDelete" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Text="A profile stores the clicker and hold settings. Save under a new name to add one, or under an existing name to replace it." />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="NEXT PROFILE KEY" Margin="0,16,0,6" />
                    <Button x:Name="ProfileKeyButton" Style="{StaticResource KeyButton}" Click="OnProfileKeyButtonClick" />

                    <Separator Margin="0,16,0,12" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="APPEARANCE" />
                    <CheckBox x:Name="DarkModeCheck" Content="Dark mode" Checked="OnDarkModeChanged" Unchecked="OnDarkModeChanged" />

                    <Separator Margin="0,16,0,12" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="STARTUP" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Checked="OnStartupChanged" Unchecked="OnStartupChanged" Margin="0,0,0,4" />
                    <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized" Checked="OnStartupChanged" Unchecked="OnStartupChanged" Margin="0,0,0,4" />
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to the tray" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                    <TextBlock Style="{StaticResource HintText}" Text="Start minimized only applies when it starts with Windows. It goes to the tray when that is on." Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>

        <!-- Shows which mode is running, sitting on the same row as the tab headers -->
        <Border x:Name="ActivityPill"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Padding="10,5"
                Background="{DynamicResource ControlHoverBrush}"
                CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ActivityDot"
                         Width="9"
                         Height="9"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="ActivityText"
                           Text="Idle"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Short messages appear here, at the top of the window -->
        <Border x:Name="ToastBorder"
                Visibility="Collapsed"
                Panel.ZIndex="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Padding="14,7"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="14">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
