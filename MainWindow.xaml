<Window x:Class="MouseClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Clicker"
        Width="580"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnClosed">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">

        <TextBlock Text="Interval (ms, min 10)" />
        <TextBox x:Name="IntervalBox" Margin="0,2,0,12" TextChanged="OnIntervalChanged" />

        <TextBlock x:Name="JitterLabel" Text="Random jitter: 10%" />
        <Slider x:Name="JitterSlider"
                Margin="0,2,0,12"
                Minimum="0"
                Maximum="50"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                ValueChanged="OnJitterChanged" />

        <TextBlock Text="Trigger mode" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
            <RadioButton x:Name="ToggleRadio" Content="Toggle" Margin="0,0,20,0" Checked="OnModeChanged" />
            <RadioButton x:Name="HoldRadio" Content="Hold" Checked="OnModeChanged" />
        </StackPanel>

        <CheckBox x:Name="NotifyCheck" Content="Show notification when clicking starts" Margin="0,0,0,12" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged" />

        <TextBlock Text="Hotkey (click to change, Esc cancels)" />
        <Button x:Name="HotkeyButton"
                Margin="0,2,0,12"
                MinWidth="120"
                HorizontalAlignment="Left"
                Click="OnHotkeyButtonClick" />

        <Button x:Name="StartStopButton" Height="28" Click="OnStartStopClick" />

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Text="Stopped" />
    </StackPanel>

        <Border Grid.Column="1"
                Margin="24,0,0,0"
                Padding="16"
                VerticalAlignment="Top"
                BorderBrush="#FFBBBBBB"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Clicks" FontWeight="SemiBold" />
                <TextBlock x:Name="ClickCountText" Text="0" FontSize="28" Margin="0,2,0,16" />
                <TextBlock Text="Last click" FontWeight="SemiBold" />
                <TextBlock x:Name="LastClickText" Text="-" FontFamily="Consolas" FontSize="18" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
